# Pick at least one provider key (others can stay empty).
CEREBRAS_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
GLM_API_KEY=
MISTRAL_API_KEY=
# Cloudflare Workers AI. The endpoint carries the account id; the app reads it
# from the token when you save the key in Settings. Set it here only to pin one.
CLOUDFLARE_API_KEY=
CLOUDFLARE_BASE_URL=
# OVHcloud AI Endpoints (EU-hosted). Use the literal "anonymous" for the free
# shared tier — slow (2 requests/minute) and worth it only to try the app.
OVH_API_KEY=
# Any other OpenAI-compatible endpoint: a local server or a gateway.
CUSTOM_API_KEY=
CUSTOM_BASE_URL=

# Provider selection (optional — first available from order is used)
LLM_PROVIDER=
LLM_MODEL=

# Retry / backoff for LLM calls
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=1.0

# Rate limiting on /api/chat, /api/scan, /api/upload-cv
ENABLE_RATE_LIMIT=1

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Server
PORT=8000

# Override DB path (defaults to data/searcher.db inside the workspace)
SEARCHER_DB_PATH=
